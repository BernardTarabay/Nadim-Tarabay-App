# Copy to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables instead (never commit real values).

# Contact form email. SMTP_PASS is a Google "app password" (16 characters), not the account password:
# Google Account → Security → 2-Step Verification (must be on) → App passwords.
# Without these, local messages are printed in the terminal and the live form asks visitors to email directly.
# The Gmail account that sends (and owns the app password); messages are delivered to CONTACT_TO.
SMTP_USER=nadimtarabaypodcast@gmail.com
SMTP_PASS=

# Optional: send the messages to another inbox (default: the address in shared/contact.js).
# CONTACT_TO=

# Optional, only for a provider other than Gmail (defaults: smtp.gmail.com and 465).
# SMTP_HOST=
# SMTP_PORT=
